# Open-Inspect local web configuration
#
# Copy this file to .env.web, then run `npm run dev` from the repository root.
# The local web process does not need GitHub, Cloudflare, or model-provider API
# keys. Those credentials belong to the control plane and its Terraform config.
# See terraform/environments/production/terraform.tfvars.example when deploying
# a complete Open-Inspect stack.
#
# Do not put workforce IdP client secrets here. Configure the IdP in Cloudflare
# Zero Trust. See docs/IDP_AND_ACCESS_SETUP.md.

# Explicit loopback-only bypass for `next dev`. Production refuses this flag.
AUTH_DEV_BYPASS=1
# For Access-protected development, remove the bypass and set both values.
# Production requires these on the web service through Terraform or its host.
# CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUD=YOUR_OPENINSPECT_APPLICATION_AUD_TAG

# Dedicated development control plane. Its WEB_APP_URL must be
# http://localhost:3000 for browser authentication to work locally.
CONTROL_PLANE_URL=https://open-inspect-control-plane-YOUR-NAME.YOUR-SUBDOMAIN.workers.dev
NEXT_PUBLIC_WS_URL=wss://open-inspect-control-plane-YOUR-NAME.YOUR-SUBDOMAIN.workers.dev

# Web-to-control-plane signing secret. This must match the deployed control
# plane's SERVICE_AUTH_SECRET_WEB binding. Do not generate a different value.
SERVICE_AUTH_SECRET=

# Optional deployment metadata. Keep these aligned with the control plane.
NEXT_PUBLIC_SCM_PROVIDER=github
NEXT_PUBLIC_SANDBOX_PROVIDER=modal
LOG_LEVEL=info

# Optional branding. Restart the development server after changing these.
NEXT_PUBLIC_APP_NAME=Open-Inspect
NEXT_PUBLIC_APP_ICON_URL=
